rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == "tahamid.learning@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && (isBootstrappedAdmin() || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 254 &&
        data.role in ['admin', 'payroll-manager', 'operator', 'auditor'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['projectId', 'name', 'status', 'updatedAt']) &&
        data.keys().hasOnly(['projectId', 'name', 'status', 'countries', 'updatedBy', 'updatedAt']) &&
        data.projectId is string && data.projectId.size() <= 64 &&
        data.name is string && data.name.size() <= 150 &&
        data.status in ['active', 'inactive', 'archived'] &&
        (!('countries' in data) || (data.countries is list && data.countries.size() <= 30));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['eventId', 'userId', 'action', 'entityType', 'timestamp']) &&
        data.keys().hasOnly(['eventId', 'userId', 'action', 'entityType', 'timestamp']) &&
        data.eventId is string && data.eventId.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.action is string && data.action.size() <= 80 &&
        data.entityType is string && data.entityType.size() <= 80;
    }

    // Test connection document for initial SDK verification
    match /test/{testId} {
      allow get: if true;
    }

    // User Profiles with Split Access & Role Hardening
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) &&
        (isAdmin() || incoming().role == 'operator');
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Admin Role Document Markers
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isBootstrappedAdmin();
    }

    // Projects Sync Collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isAdmin() && isValidId(projectId);
    }

    // Tamper-Resistant Audit Logs (Create & Read only)
    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }
  }
}
